# Required: Your Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Server port (defaults to 3000)
PORT=3000

# Runtime mode: use "development" with `npm run dev`, or "production" with `npm start`
NODE_ENV=development

# Public URL of the app (for local VS Code / laptop development, use http://localhost:3000)
APP_URL="http://localhost:3000"
